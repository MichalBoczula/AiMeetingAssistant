<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiMeetingAssistant.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/ai-meeting-assistant.ico"
                ToolTipText="AI Meeting Assistant — hotkey: Left Ctrl + Left Alt + Left Shift + F">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Exit"
                            Click="ExitApplication" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
